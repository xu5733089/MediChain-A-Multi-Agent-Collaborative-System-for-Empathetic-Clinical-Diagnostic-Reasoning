# Anthropic API key — required for all AI agents
# Obtain from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter API key — required for Mistral peer-review judge in eval dashboard
# Obtain from: https://openrouter.ai/keys  (free tier available)
# If omitted, the Mistral judge shows "UNAVAILABLE" but all other features work normally.
MISTRAL_API_KEY=sk-or-...
